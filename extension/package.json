{
  "name": "steadyhand-extension",
  "version": "0.1.0",
  "private": true,
  "description": "What the strategy you chose implies, read from what your broker's page shows.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/readers",
    "packages/history",
    "packages/shell"
  ],
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage",
    "test:guards": "vitest run --project guards --mode guards --coverage",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "build": "node build.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "acorn": "8.19.0",
    "amaro": "1.3.0",
    "ast-v8-to-istanbul": "1.0.8",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
